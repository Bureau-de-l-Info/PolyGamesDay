---
interface Props {
    label: string;
    image: string;
    link: string;
}

const { label, image, link } = Astro.props;
---

<a target="_blank" aria-label={label} href={link}>
    <img loading="lazy" alt={label} src={image} />
</a>

<style>
    a {
        height: 15vh;
        display: flex;
        flex: 0 0 200px;
        align-items: center;
        justify-content: center;
        transition: transform 200ms var(--ease-snappy);
    }

    a:hover {
        transform: scale(1.05);
        -webkit-transform: scale(1.05);
    }

    img {
        max-width: 100%;
        max-height: 100%;
    }
</style>
