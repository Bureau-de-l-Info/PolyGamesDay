---
import Section from "@components/Section.astro";
---

<Section>
    <div class="centered">
        <div class="bottom-line">
            <img
                src="/images/team.webp"
                loading="lazy"
                alt="L'équipe du Poly Gaming Day"
            />
        </div>

        <div>
            <h2>Notre Équipe</h2>

            <p>
                Le Bureau de l'Info de l'école d'ingénieur Polytech Nancy est
                une association étudiante. Elle a pour but de promouvoir
                l'informatique et le monde du jeu vidéo auprès des étudiants de
                l'école.
            </p>
        </div>
    </div>
</Section>

<style>
    img {
        max-width: 40vw;
    }

    h2 {
        text-align: left;
    }

    p {
        max-width: 30vw;
        font-size: 1.125rem;
    }

    .bottom-line {
        position: relative;
        margin-right: 5vw;

        &::after {
            content: "";
            left: 0;
            bottom: 0;
            width: 100%;
            height: 10px;
            position: absolute;
            border-radius: 3px;
            background-color: var(--accent-color);
        }
    }

    @media (max-width: 1100px) {
        .centered {
            gap: 5vw;
            flex-direction: column-reverse;
        }

        h2 {
            text-align: center;
        }

        p,
        img {
            max-width: min(850px, 80vw);
        }
    }
</style>
